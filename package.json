{
  "name": "attendance-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "نظام ذكي لإدارة ومراقبة حضور وغياب الموظفين وفرق العمل عبر تقارير الإكسل اليومية",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/clear-start.cjs",
    "clear:start": "node scripts/clear-start.cjs",
    "clear-start": "node scripts/clear-start.cjs",
    "clear": "node scripts/clear-start.cjs",
    "desktop:dev": "cross-env VITE_ELECTRON=true vite",
    "build": "tsc -b && vite build",
    "desktop:build": "cross-env VITE_ELECTRON=true vite build && electron-builder",
    "desktop:dist": "electron-builder --win --x64",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.7.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.attendance.intelligence",
    "productName": "نظام مراقبة الحضور والغياب",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}_Setup_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام مراقبة الحضور والغياب"
    }
  }
}
